{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VoxMelody",
  "version": "1.0.0",
  "identifier": "io.github.akhil272.voxmelody",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm engines && pnpm dev",
    "beforeBuildCommand": "pnpm engines && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "VoxMelody",
        "width": 1120,
        "height": 720,
        "minWidth": 1020,
        "minHeight": 640,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-only",
    "category": "Music",
    "resources": { "../LICENSE": "LICENSE", "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md" },
    "externalBin": ["binaries/voxmelody-voice", "binaries/voxmelody-music"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
